algoritmo "26"
var
   N1,N2 : inteiro
inicio


   Escreva ("digite um numero: ")
   Leia (n1)
   Escreva ("digite outro numero: ")
   Leia (n2)

   Se N1 > N2 entao
      Escreva ("o primeiro valor é maior ")
   Fimse
   Se N1<N2    entao
      Escreva ("o segundo valor é maior ")
   Fimse
   Se N1=N2 entao

      Escreva ("Não existe valor maior, os dois são igual")
   FimSe

fimalgoritmo