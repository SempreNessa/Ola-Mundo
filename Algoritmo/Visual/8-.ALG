algoritmo "medidas"
var

m,Km,cm,mm,HM: real

inicio
Escreva ("Digite uma distancia em Metros: ")
Leia (m)
KM <- m/1000
HM <- m/100
CM <- m*100
MM <- m*1000
Escreval ("A distancia de " ,m, "m é de: " ,KM, "km." )
Escreval ("A distancia de " ,m, "m é de: " ,HM, "hm." )
Escreval ("A distancia de ",m,"m é de: " ,CM, "cm." )
Escreval ("Adistancia de " ,m,"m é de: ",MM, "mm.")
fimalgoritmo