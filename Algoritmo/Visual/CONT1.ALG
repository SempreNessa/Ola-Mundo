algoritmo "cont"
var

salto,valor,cont : inteiro

inicio
 cont <- 0
 Escreval ("quer contar até quanto?")
 Leia (valor)
 Escreval ("qual será o valor do salto?")
 Leia (salto)
 Enquanto (cont <= valor ) faca
 Escreval (cont)
  cont <- cont + salto
  
 FimEnquanto
    Escreval ("terminei de contar")



fimalgoritmo